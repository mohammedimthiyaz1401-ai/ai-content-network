# Copy this file to load_secrets.ps1 and fill in your values.
# load_secrets.ps1 is gitignored — never commit real keys.
#
# Usage (each PowerShell session):
#   . .\scripts\load_secrets.ps1
#   python src/main_pipeline.py --test

$env:REPLICATE_API_TOKEN = "r8_YOUR_TOKEN_HERE"
$env:GEMINI_API_KEY = "YOUR_GEMINI_KEY_HERE"
$env:YOUTUBE_CLIENT_ID = "YOUR_CLIENT_ID.apps.googleusercontent.com"
$env:YOUTUBE_CLIENT_SECRET = "YOUR_CLIENT_SECRET"
$env:YOUTUBE_REFRESH_TOKEN = "YOUR_REFRESH_TOKEN"
$env:YOUTUBE_CHANNEL_ID = "UCd5yt5eiM97UDyWkt9mZGQw"
# Optional (daily report push): create bot via @BotFather, get chat id via @userinfobot
$env:TELEGRAM_BOT_TOKEN = "YOUR_BOT_TOKEN"
$env:TELEGRAM_CHAT_ID = "YOUR_CHAT_ID"

Write-Host "Secrets loaded for this session." -ForegroundColor Green
